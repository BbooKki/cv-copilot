# Browser-safe Supabase configuration. Never use a secret or service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Feature switches
VITE_GEMMA_ENABLED=true
# Set true only after Auth redirect URLs and the owner-only migration are configured.
VITE_CLOUD_ENABLED=false

# Server-only extraction configuration
JOB_FETCH_TIMEOUT_MS=10000
JOB_FETCH_MAX_BYTES=1500000
