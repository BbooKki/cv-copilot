# Browser-safe Supabase configuration. Never use a secret or service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Feature switches
VITE_GEMMA_ENABLED=true
# Set true only after Auth redirect URLs and the owner-only migration are configured.
VITE_CLOUD_ENABLED=false

# Server-only extraction configuration
JOB_FETCH_TIMEOUT_MS=10000
JOB_FETCH_MAX_BYTES=1500000

# Server-only cloud AI (Google AI Studio / Gemini). Never prefix with VITE_.
GEMINI_API_KEY=
# Optional overrides (gemini-2.5-* names are retired for keys created in 2026)
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=30000
GEMINI_RETRIES=1
# Emergency switch and best-effort serverless quota protection.
CLOUD_AI_ENABLED=true
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=8
AI_GLOBAL_DAILY_MAX_REQUESTS=250
